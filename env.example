# Copy this file to .env and fill it in. Never commit .env.

# DetectifAI — platform.detectif.ai → API keys (scopes: deepfake:detect, credits:read)
DETECTIF_API_KEY=
DETECTIF_BASE_URL=https://platform.detectif.ai

# Telegram — @BotFather → /newbot, then /setprivacy → Disable, then re-add the bot to the group
TELEGRAM_BOT_TOKEN=

# Public HTTPS address of api.py (ngrok static domain). Used for result links + the PWA.
PUBLIC_BASE_URL=http://localhost:8000

# Mock mode: real_en | fake_en | fake_hi | fake_kn | spliced_en | spliced_whatsapp | cycle
# (also error_insufficient_speech, error_too_large, ... to test error replies). Empty = real API.
MOCK_ALETHEIA=cycle

# Optional
DEFAULT_LANG=en
DB_PATH=data/app.db
# Path to Chromaprint's fpcalc (download: see README). Use "fpcalc" if it's on PATH.
# Linux (Fedora: sudo dnf install chromaprint-tools): "fpcalc" on PATH is also found automatically.
FPCALC_PATH=bin/fpcalc.exe
